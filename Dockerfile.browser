# Yalıtılmış gerçek tarayıcı yan konteyneri (Faz 5) — docker-compose.browser.yml ile kullanılır.
# Scanner konteynerinden AYRIDIR: çalışma alanı, bulut kimlik bilgisi ya da Docker soketi BAĞLANMAZ.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium-headless-shell fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 browser \
    && mkdir -p /app /run/wss-browser \
    && chown browser:browser /run/wss-browser

WORKDIR /app
COPY headless_browser.py safety_guard.py browser_service.py /app/

USER browser
EXPOSE 9230
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9230/health', timeout=3)" || exit 1
CMD ["python3", "browser_service.py"]
